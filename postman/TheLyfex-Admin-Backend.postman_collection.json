{
  "info": {
    "name": "TheLyfex Admin Backend (Day 1) — Collection",
    "_postman_id": "b4caa2c6-5bd7-4dc9-a9c3-8730c8bb0b5b",
    "description": "Admin backend API tests for admin-backend. Includes happy paths and edge cases (401/403/400/404) with auth chaining.\n\nVariables used:\n- baseUrl (default http://localhost:4100)\n- adminEmail, adminPassword\n- adminAccessToken, adminRefreshToken\n- adminId, roleId\n- userId\n- roomId\n- reportId\n\nNotes:\n- Run \"Admin Auth → Login\" first to set tokens.\n- Some endpoints require permissions (roles/permissions). If your current admin role lacks permissions you will receive 403 (expected in edge-case tests).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4100", "type": "string" },
    { "key": "adminEmail", "value": "admin@thelyfex.com", "type": "string" },
    { "key": "adminPassword", "value": "ChangeMeStrong9!", "type": "string" },
    { "key": "adminAccessToken", "value": "", "type": "string" },
    { "key": "adminRefreshToken", "value": "", "type": "string" },
    { "key": "adminId", "value": "", "type": "string" },
    { "key": "roleId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "roomId", "value": "", "type": "string" },
    { "key": "reportId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-attach Bearer token if present and not already set",
          "const t = pm.collectionVariables.get('adminAccessToken');",
          "if (t && !pm.request.headers.has('Authorization')) {",
          "  pm.request.headers.add({ key: 'Authorization', value: `Bearer ${t}` });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generic JSON parse helper",
          "function safeJson() {",
          "  try { return pm.response.json(); } catch { return null; }",
          "}",
          "",
          "// For 5xx, fail loudly with body",
          "if (pm.response.code >= 500) {",
          "  pm.test('No 5xx errors', function () {",
          "    pm.expect(pm.response.code).to.be.below(500);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Login (happy path) — sets tokens",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Has accessToken', () => pm.expect(j.accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('Has refreshToken', () => pm.expect(j.refreshToken).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('adminAccessToken', j.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', j.refreshToken);",
                  "if (j.admin && j.admin.id) pm.collectionVariables.set('adminId', String(j.admin.id));",
                  "if (j.admin && j.admin.role && j.admin.role.id) pm.collectionVariables.set('roleId', String(j.admin.role.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (edge) — missing password (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "login"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.expect(pm.response.code).to.eql(400));"] }
            }
          ]
        },
        {
          "name": "Refresh token (happy path) — rotates refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/admin/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "refresh-token"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', j.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token (edge) — invalid refresh (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/admin/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "refresh-token"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"invalid-token\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 401', () => pm.expect(pm.response.code).to.eql(401));"] } }
          ]
        },
        {
          "name": "Me (happy path)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/me",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "me"]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Me (edge) — missing auth (expect 401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "", "disabled": true }],
            "url": {
              "raw": "{{baseUrl}}/admin/me",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "me"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.request.headers.upsert({ key: 'Authorization', value: '' });"] }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 401', () => pm.expect(pm.response.code).to.eql(401));"] }
            }
          ]
        },
        {
          "name": "Update profile (happy path) — change fullName only",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/admin/profile",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "profile"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Admin User\"\n}" }
          }
        },
        {
          "name": "Logout (happy path) — revoke refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/admin/logout",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "logout"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
          ]
        }
      ]
    },
    {
      "name": "Roles & Permissions (RBAC)",
      "item": [
        {
          "name": "List roles",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] }
          }
        },
        {
          "name": "List permission catalog",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/roles/permissions/catalog",
              "host": ["{{baseUrl}}"],
              "path": ["roles", "permissions", "catalog"]
            }
          }
        },
        {
          "name": "Create role (happy path) — custom role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/roles/create", "host": ["{{baseUrl}}"], "path": ["roles", "create"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Role\",\n  \"slug\": \"qa_role\",\n  \"permissionKeys\": [\"users.read\"],\n  \"description\": \"Role for QA\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 or 403 (depends on permissions)', () => pm.expect([201,403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create role (edge) — invalid slug (expect 400 or 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/roles/create", "host": ["{{baseUrl}}"], "path": ["roles", "create"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad\",\n  \"slug\": \"BAD SLUG\",\n  \"permissionKeys\": []\n}"
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400 or 403', () => pm.expect([400,403]).to.include(pm.response.code));"] } }
          ]
        }
      ]
    },
    {
      "name": "Admin CRUD & Activity Logs",
      "item": [
        {
          "name": "List admins",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/all?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["admin", "all"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] } },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200 or 403', () => pm.expect([200,403]).to.include(pm.response.code));"] } }
          ]
        },
        {
          "name": "Create admin (happy path) — requires admins.manage",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/create", "host": ["{{baseUrl}}"], "path": ["admin", "create"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new-admin@example.com\",\n  \"password\": \"A-Strong-Password-123!\",\n  \"fullName\": \"New Admin\",\n  \"roleId\": \"{{roleId}}\"\n}"
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 201/400/403', () => pm.expect([201,400,403]).to.include(pm.response.code));"] } }
          ]
        },
        {
          "name": "Activity logs (happy path) — requires activity.read",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/activity-logs?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "activity-logs"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200 or 403', () => pm.expect([200,403]).to.include(pm.response.code));"] } }
          ]
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "List users (happy path) — default not deleted",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "List users (filters) — status=deleted",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?status=deleted&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "status", "value": "deleted" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "List users (filters) — active + country + joinedAfter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?status=active&country=IN&joinedAfter=2020-01-01T00:00:00.000Z&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "status", "value": "active" },
                { "key": "country", "value": "IN" },
                { "key": "joinedAfter", "value": "2020-01-01T00:00:00.000Z" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List users (edge) — invalid joinedAfter date (expect 400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?joinedAfter=not-a-date",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "joinedAfter", "value": "not-a-date" }]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 400', () => pm.expect(pm.response.code).to.eql(400));"] } }
          ]
        },
        {
          "name": "Get user by id (happy path) — includes stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 404', () => pm.expect([200,404]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.test('Has stats', () => pm.expect(j.stats).to.be.an('object'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Block user (happy path)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/block/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "block", "{{userId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"block\": true,\n  \"reason\": \"testing\"\n}" }
          }
        },
        {
          "name": "Suspend user (happy path) — until date",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/suspend/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "suspend", "{{userId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"suspend\": true,\n  \"until\": \"2030-01-01T00:00:00.000Z\"\n}" }
          }
        },
        {
          "name": "Assign badge (happy path) — logs ASSIGN_BADGE",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/assign-badge/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "assign-badge", "{{userId}}"] }
          }
        },
        {
          "name": "Reset account flags (happy path) — logs RESET_ACCOUNT",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/reset/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "reset", "{{userId}}"] }
          }
        },
        {
          "name": "Get user (edge) — invalid id (expect 404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/000000000000000000000000", "host": ["{{baseUrl}}"], "path": ["users", "000000000000000000000000"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 404', () => pm.expect(pm.response.code).to.eql(404));"] } }
          ]
        }
      ]
    },
    {
      "name": "Discussion Admin",
      "item": [
        {
          "name": "List rooms",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/discuss/rooms?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["discuss", "rooms"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Get room (by roomId or mongo _id)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/discuss/room/{{roomId}}", "host": ["{{baseUrl}}"], "path": ["discuss", "room", "{{roomId}}"] } }
        },
        {
          "name": "Pin room",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/discuss/pin/{{roomId}}", "host": ["{{baseUrl}}"], "path": ["discuss", "pin", "{{roomId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"pinned\": true\n}" }
          }
        },
        {
          "name": "Feature room",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/discuss/feature/{{roomId}}", "host": ["{{baseUrl}}"], "path": ["discuss", "feature", "{{roomId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"featured\": true\n}" }
          }
        },
        {
          "name": "List reports",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/discuss/reports?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["discuss", "reports"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] } }
        },
        {
          "name": "Update report status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/discuss/reports/{{reportId}}", "host": ["{{baseUrl}}"], "path": ["discuss", "reports", "{{reportId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"reviewing\",\n  \"adminNote\": \"Investigating\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "User analytics summary",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/analytics/users", "host": ["{{baseUrl}}"], "path": ["analytics", "users"] } }
        },
        {
          "name": "Discussion analytics summary",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/analytics/discussions", "host": ["{{baseUrl}}"], "path": ["analytics", "discussions"] } }
        }
      ]
    }
  ]
}

