# LYFEX_MAIN_BACKEND_ROOT=C:\path\to\Lyfex-backend

# Server
ADMIN_PORT=4100
ADMIN_CORS_ORIGINS=http://localhost:5173

# Tokens (distinct from main app JWT_SECRET)
